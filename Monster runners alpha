-- Get All: Loops through players inside their body and waits until each target dies before moving on
local getAllEnabled = false
local getAllThread = nil

local function isPlayerAlive(plr)
	if not plr or not plr.Parent or plr == LocalPlayer then
		return false
	end
	local char = plr.Character
	if not char or not char.Parent then
		return false
	end
	local hum = char:FindFirstChildOfClass("Humanoid")
	if not hum or hum.Health <= 0 or hum:GetState() == Enum.HumanoidStateType.Dead then
		return false
	end
	return getRoot(plr) ~= nil
end

local function followUntilDead(targetPlr)
	while getAllEnabled and isPlayerAlive(targetPlr) do
		local myRoot = getRoot(LocalPlayer)
		local tRoot = getRoot(targetPlr)
		if myRoot and tRoot then
			myRoot.CFrame = tRoot.CFrame
		end
		task.wait(0.05)
	end
end

MainTab:CreateToggle({
	name = "Get All (TP Loop - Wait Until Dead)",
	callback = function(value)
		getAllEnabled = value
		if getAllEnabled then
			getAllThread = task.spawn(function()
				while getAllEnabled do
					local queue = {}
					for _, plr in ipairs(Players:GetPlayers()) do
						if plr ~= LocalPlayer and isPlayerAlive(plr) then
							table.insert(queue, plr)
						end
					end

					if #queue == 0 then
						task.wait(0.4)
					else
						for _, targetPlr in ipairs(queue) do
							if not getAllEnabled then break end
							if isPlayerAlive(targetPlr) then
								followUntilDead(targetPlr)
							end
							task.wait(0.1)
						end
					end
				end
			end)
		else
			if getAllThread then
				task.cancel(getAllThread)
				getAllThread = nil
			end
		end
	end,
})

