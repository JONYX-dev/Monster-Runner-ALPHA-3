local function setDangerVisuals(isDanger, closestDist)
	local targetStrokeColor = isDanger and Color3.fromRGB(255, 45, 55) or Color3.fromRGB(70, 225, 130)
	local targetBadgeBg = isDanger and Color3.fromRGB(85, 18, 24) or Color3.fromRGB(22, 54, 36)
