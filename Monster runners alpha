-- All Players ESP: Runners = Green, Monster = Red + Small Username & Studs (Refreshes every 1s)
local espEnabled = false
local espThread = nil

local function clearAllESP()
	for _, plr in ipairs(Players:GetPlayers()) do
		if plr.Character then
			local hl = plr.Character:FindFirstChild("CVI_PlayerESP")
			if hl then hl:Destroy() end
			local tag = plr.Character:FindFirstChild("CVI_PlayerTag")
			if tag then tag:Destroy() end
		end
	end
end

local function ensureSmallPlayerTag(char)
	local head = char:FindFirstChild("Head") or char:FindFirstChild("HumanoidRootPart") or char:FindFirstChildWhichIsA("BasePart")
	if not head then return nil end

	local tag = char:FindFirstChild("CVI_PlayerTag")
	if not tag then
		tag = Instance.new("BillboardGui")
		tag.Name = "CVI_PlayerTag"
		tag.Adornee = head
		tag.Size = UDim2.fromOffset(125, 20)
		tag.StudsOffset = Vector3.new(0, 2.2, 0)
		tag.AlwaysOnTop = true
		tag.Parent = char

		local lbl = Instance.new("TextLabel")
		lbl.Name = "TagLabel"
		lbl.Size = UDim2.fromScale(1, 1)
		lbl.BackgroundTransparency = 1
		lbl.Font = Enum.Font.GothamBold
		lbl.TextSize = 10
		lbl.TextStrokeTransparency = 0.3
		lbl.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
		lbl.Parent = tag
	end

	return tag:FindFirstChild("TagLabel")
end

local function updateAllPlayersESP()
	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= LocalPlayer and plr.Character then
			local char = plr.Character
			local monster = isPlayerMonster(plr)

			local hl = char:FindFirstChild("CVI_PlayerESP")
			if not hl then
				hl = Instance.new("Highlight")
				hl.Name = "CVI_PlayerESP"
				hl.FillTransparency = 0.48
				hl.OutlineTransparency = 0
				hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
				hl.Parent = char
			end

			if monster then
				hl.FillColor = Color3.fromRGB(255, 35, 40)
				hl.OutlineColor = Color3.fromRGB(255, 130, 135)
			else
				hl.FillColor = Color3.fromRGB(45, 235, 95)
				hl.OutlineColor = Color3.fromRGB(165, 255, 185)
			end

			local lbl = ensureSmallPlayerTag(char)
			if lbl then
				local dist = getDistanceStuds(plr)
				local studText = dist and (tostring(dist) .. "st") or "?st"
				lbl.Text = string.format("%s [%s]", plr.Name, studText)
				lbl.TextColor3 = monster and Color3.fromRGB(255, 95, 100) or Color3.fromRGB(125, 255, 155)
			end
		end
	end
end

VisualsTab:CreateToggle({
	name = "ESP All Players (Runners Green / Monster Red - 1s)",
	callback = function(value)
		espEnabled = value
		if espEnabled then
			updateAllPlayersESP()
			espThread = task.spawn(function()
				while espEnabled do
					task.wait(1)
					if espEnabled then
						updateAllPlayersESP()
					end
				end
			end)
		else
			if espThread then
				task.cancel(espThread)
				espThread = nil
			end
			clearAllESP()
		end
	end,
})

-- Speed Boost with 10% - 90% Selection
local speedBoostEnabled = false
local selectedBoostPercent = 30
local defaultWalkSpeed = 16
local speedConn = nil

VisualsTab:CreateDropdown({
	name = "Speed Boost Selection",
	options = { "10%", "20%", "30%", "40%", "50%", "60%", "70%", "80%", "90%" },
	currentOption = { "30%" },
	multipleOptions = false,
	callback = function(option)
		local chosen = type(option) == "table" and option[1] or option
		local num = tonumber(tostring(chosen):match("(%d+)"))
		if num then
			selectedBoostPercent = num
		end
	end,
})

VisualsTab:CreateToggle({
	name = "Speed Boost",
	callback = function(value)
		speedBoostEnabled = value
		local char = LocalPlayer.Character
		local hum = char and char:FindFirstChildOfClass("Humanoid")

		if speedBoostEnabled then
			if hum and hum.WalkSpeed > 0 then
				defaultWalkSpeed = hum.WalkSpeed
			end
			speedConn = RunService.Heartbeat:Connect(function()
				local c = LocalPlayer.Character
				local h = c and c:FindFirstChildOfClass("Humanoid")
				if h then
					local multiplier = 1 + (selectedBoostPercent / 100)
					local targetSpeed = defaultWalkSpeed * multiplier
					if math.abs(h.WalkSpeed - targetSpeed) > 0.5 then
						h.WalkSpeed = targetSpeed
					end
				end
			end)
		else
			if speedConn then
				speedConn:Disconnect()
				speedConn = nil
			end
			if hum then
				hum.WalkSpeed = defaultWalkSpeed
			end
		end
	end,
})

-- Difficult Game (Darker & Dense Fog)
local origLighting = {
	Brightness = Lighting.Brightness,
	ClockTime = Lighting.ClockTime,
	FogEnd = Lighting.FogEnd,
	FogStart = Lighting.FogStart,
	FogColor = Lighting.FogColor,
	GlobalShadows = Lighting.GlobalShadows,
	Ambient = Lighting.Ambient,
	OutdoorAmbient = Lighting.OutdoorAmbient,
}

local hardModeEnabled = false
local lightingConn = nil

local function applyHardMode()
	if hardModeEnabled then
		Lighting.Brightness = 0
		Lighting.ClockTime = 0
		Lighting.FogStart = 0
		Lighting.FogEnd = 32
		Lighting.FogColor = Color3.fromRGB(5, 5, 8)
		Lighting.GlobalShadows = true
		Lighting.Ambient = Color3.fromRGB(8, 8, 12)
		Lighting.OutdoorAmbient = Color3.fromRGB(5, 5, 8)
	else
		for prop, val in pairs(origLighting) do
			Lighting[prop] = val
		end
	end
end

VisualsTab:CreateToggle({
	name = "Difficult Game (Darker & Dense Fog)",
	callback = function(value)
		hardModeEnabled = value
		applyHardMode()
		if hardModeEnabled and not lightingConn then
			lightingConn = RunService.RenderStepped:Connect(applyHardMode)
		elseif not hardModeEnabled and lightingConn then
			lightingConn:Disconnect()
			lightingConn = nil
		end
	end,
})
