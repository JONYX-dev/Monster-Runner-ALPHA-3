-- Player Selection Dropdown: Runner (number) Username
local selectedPlayerEntry = nil
local playerEntryMap = {}

local function buildPlayerSelectionList()
	local options = {}
	table.clear(playerEntryMap)

	local runnerCount = 0
	local monsterCount = 0

	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= LocalPlayer then
			local label
			if isPlayerMonster(plr) then
				monsterCount += 1
				label = string.format("Monster (%d) %s", monsterCount, plr.Name)
			else
				runnerCount += 1
				label = string.format("Runner (%d) %s", runnerCount, plr.Name)
			end
			table.insert(options, label)
			playerEntryMap[label] = plr
		end
	end

	if #options == 0 then
		table.insert(options, "No other players")
	end

	return options
end

local initialPlayerOptions = buildPlayerSelectionList()
