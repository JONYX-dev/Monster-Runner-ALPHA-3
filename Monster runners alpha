local function getRoot(plr)
	local targetPlr = plr or LocalPlayer
	local char = targetPlr.Character
	return char and (char:FindFirstChild("HumanoidRootPart") or char:FindFirstChildWhichIsA("BasePart"))
end

local function getDistanceStuds(plr)
	local myRoot = getRoot(LocalPlayer)
	local pRoot = getRoot(plr)
	if myRoot and pRoot then
		return math.floor((pRoot.Position - myRoot.Position).Magnitude)
	end
	return nil
end

local function teleportTo(targetCF)
	local root = getRoot(LocalPlayer)
	if root then
		root.CFrame = targetCF
	end
end

-- Teleports to target, fires nearby ProximityPrompt, and returns to original spot
local function teleportAndPrompt(targetCF, promptKeyword)
	local root = getRoot(LocalPlayer)
	if not root then return end

	local savedCF = root.CFrame
	root.CFrame = targetCF
	task.wait(0.25)

	for _, obj in ipairs(workspace:GetDescendants()) do
		if obj:IsA("ProximityPrompt") and obj.Enabled then
			local parentPart = obj.Parent:IsA("BasePart") and obj.Parent or obj.Parent:FindFirstChildWhichIsA("BasePart")
			if parentPart and (parentPart.Position - targetCF.Position).Magnitude <= 18 then
				local action = (obj.ActionText or ""):lower()
				local objectText = (obj.ObjectText or ""):lower()
				if not promptKeyword or action:find(promptKeyword) or objectText:find(promptKeyword) then
					if typeof(fireproximityprompt) == "function" then
						fireproximityprompt(obj)
					else
						obj:InputHoldBegin()
						task.wait(obj.HoldDuration + 0.05)
						obj:InputHoldEnd()
					end
					break
				end
			end
		end
	end

	task.wait(0.2)
	if getRoot(LocalPlayer) then
		getRoot(LocalPlayer).CFrame = savedCF
	end
end

-- ==================== MONSTER / RUNNER ROLE DETECTION ====================

local function hasMonsterKeyword(text)
	if type(text) ~= "string" then return false end
	local low = text:lower()
	return low:find("monster") or low:find("killer") or low:find("beast") or low:find("hunter") or low:find("slasher") or low:find("fiend")
end

local function isPlayerMonster(plr)
	if plr == LocalPlayer then return false end

	if plr.Team and hasMonsterKeyword(plr.Team.Name) then
		return true
	end

	for attrName, attrVal in pairs(plr:GetAttributes()) do
		if hasMonsterKeyword(attrName) and (attrVal == true or hasMonsterKeyword(tostring(attrVal))) then
			return true
		end
	end

	local char = plr.Character
	if char then
		for attrName, attrVal in pairs(char:GetAttributes()) do
			if hasMonsterKeyword(attrName) and (attrVal == true or hasMonsterKeyword(tostring(attrVal))) then
				return true
			end
		end

		for _, desc in ipairs(char:GetDescendants()) do
			if hasMonsterKeyword(desc.Name) then
				if desc:IsA("BoolValue") and desc.Value == true then
					return true
				elseif desc:IsA("StringValue") and hasMonsterKeyword(desc.Value) then
					return true
				elseif desc:IsA("Model") or desc:IsA("Folder") or desc:IsA("Highlight") or desc:IsA("Script") or desc:IsA("LocalScript") then
					return true
				end
			end
			if desc:IsA("Tool") then
				return true
			end
		end
	end

	local backpack = plr:FindFirstChild("Backpack")
	if backpack then
		for _, tool in ipairs(backpack:GetChildren()) do
			if tool:IsA("Tool") then
				return true
			end
		end
	end

	return false
end

