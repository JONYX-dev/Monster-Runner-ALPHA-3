		statusBadge.Text = string.format("MONSTER %d STUDS", math.floor(closestDist))
	else
		statusBadge.Text = "SAFE"
	end
end

task.spawn(function()
	while hudGui.Parent do
		local runners = {}
		local monsters = {}
		local closestMonsterDist = math.huge

		for _, plr in ipairs(Players:GetPlayers()) do
			if isPlayerMonster(plr) then
				local dist = getDistanceStuds(plr)
				local distStr = ""
				if dist then
					distStr = string.format(" [%d studs]", dist)
					if dist < closestMonsterDist then
						closestMonsterDist = dist
					end
				end
				table.insert(monsters, plr.Name .. distStr)
			elseif plr ~= LocalPlayer then
				table.insert(runners, plr.Name)
			end
		end

		local monsterText = #monsters > 0
			and ("<font color=\"rgb(255,80,85)\"><b>Monster:</b> " .. table.concat(monsters, ", ") .. "</font>")
			or "<font color=\"rgb(255,140,140)\"><b>Monster:</b> None / Selecting</font>"

		local runnerText = #runners > 0
			and ("<font color=\"rgb(95,245,135)\"><b>Runners (" .. #runners .. "):</b></font> " .. table.concat(runners, ", "))
			or "<font color=\"rgb(160,170,190)\"><b>Runners (0):</b> None</font>"

		rosterLabel.Text = monsterText .. "\n" .. runnerText

		local monsterNearby = closestMonsterDist <= DANGER_DISTANCE
		setDangerVisuals(monsterNearby, closestMonsterDist)

		task.wait(0.25)
	end
end)

